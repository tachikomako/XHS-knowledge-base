{
  "manifest_version": 3,
  "name": "小红书个人知识库",
  "description": "将用户主动访问的小红书收藏保存到本地个人知识库。",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "小红书个人知识库",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.xiaohongshu.com/*"
  ]
}
